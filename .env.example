# LLM API Configuration
# Set at least one of the following API keys to use LLM features

# OpenAI (recommended)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (alternative - requires langchain-anthropic package)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Note: If no API key is set, use --dry-run mode for template-based drafts
